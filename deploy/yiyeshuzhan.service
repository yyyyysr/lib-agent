[Unit]
Description=一页书展服务器
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yiyeshuzhan
Group=yiyeshuzhan
EnvironmentFile=/etc/yiyeshuzhan/server.env
ExecStart=/usr/local/bin/node /opt/yiyeshuzhan/server.mjs
Restart=on-failure
RestartSec=3
# 以普通账号监听 443 端口
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/yiyeshuzhan
UMask=0077
MemoryMax=1500M
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
